{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.io/bootstrap/v1/signing_root.schema.json",
  "title": "Mindclade bootstrap signing roots",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "bootstrap.mindclade.dev/v1" },
    "kind": { "const": "SigningRootSet" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectRef",
        "location",
        "keyRing",
        "administrators",
        "nixCacheSigningRoot",
        "keys"
      ],
      "properties": {
        "projectRef": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "location": { "const": "us-central1" },
        "keyRing": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "administrators": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/envRef" }
        },
        "nixCacheSigningRoot": { "$ref": "#/$defs/nixCacheSigningRoot" },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bootstrap-handoff",
            "audit-anchor",
            "recovery-evidence",
            "connected-observation-evidence",
            "github-config-plan-evidence",
            "infrastructure-export",
            "supply-chain-provenance"
          ],
          "properties": {
            "bootstrap-handoff": { "$ref": "#/$defs/key" },
            "audit-anchor": { "$ref": "#/$defs/key" },
            "recovery-evidence": { "$ref": "#/$defs/key" },
            "connected-observation-evidence": { "$ref": "#/$defs/key" },
            "github-config-plan-evidence": { "$ref": "#/$defs/key" },
            "infrastructure-export": { "$ref": "#/$defs/key" },
            "supply-chain-provenance": { "$ref": "#/$defs/key" }
          }
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" } }
    },
    "envRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valueFrom"],
      "properties": {
        "valueFrom": {
          "type": "object",
          "additionalProperties": false,
          "required": ["env"],
          "properties": { "env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" } }
        }
      }
    },
    "nixCacheSigningRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "activationEnabled",
        "secretId",
        "algorithm",
        "secretStorage",
        "secretVersionWriteOnly",
        "publicKeys",
        "publicKeyDigest",
        "accessorPrincipals",
        "requiredReviewerGates",
        "reviewerEvidenceDigest",
        "blockers"
      ],
      "properties": {
        "state": { "enum": ["DISABLED", "ACTIVATED"] },
        "activationEnabled": { "type": "boolean" },
        "secretId": { "const": "nix-cache-signing-key" },
        "algorithm": { "const": "ED25519" },
        "secretStorage": { "const": "SECRET_MANAGER_WRITE_ONLY" },
        "secretVersionWriteOnly": { "type": ["integer", "null"], "minimum": 1 },
        "publicKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*-v[1-9][0-9]*:[A-Za-z0-9+/]{43}=$"
          }
        },
        "publicKeyDigest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "accessorPrincipals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^serviceAccount:[a-z][a-z0-9-]{1,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com$"
          }
        },
        "requiredReviewerGates": {
          "type": "array",
          "prefixItems": [{ "const": "security" }, { "const": "platform" }],
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "reviewerEvidenceDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
        }
      },
      "oneOf": [
        {
          "properties": {
            "state": { "const": "DISABLED" },
            "activationEnabled": { "const": false },
            "secretVersionWriteOnly": { "type": "null" },
            "publicKeys": { "maxItems": 0 },
            "publicKeyDigest": { "type": "null" },
            "accessorPrincipals": { "maxItems": 0 },
            "reviewerEvidenceDigest": { "type": "null" },
            "blockers": { "minItems": 1 }
          }
        },
        {
          "properties": {
            "state": { "const": "ACTIVATED" },
            "activationEnabled": { "const": true },
            "secretVersionWriteOnly": { "type": "integer", "minimum": 1 },
            "publicKeys": { "minItems": 1 },
            "publicKeyDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "accessorPrincipals": { "minItems": 1 },
            "reviewerEvidenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "blockers": { "maxItems": 0 }
          }
        }
      ]
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "algorithm",
        "protectionLevel",
        "rotationDays",
        "activeVersionRef",
        "versions",
        "deletionProtection",
        "signers"
      ],
      "properties": {
        "purpose": { "const": "ASYMMETRIC_SIGN" },
        "algorithm": { "const": "EC_SIGN_P256_SHA256" },
        "protectionLevel": { "const": "HSM" },
        "rotationDays": { "const": 90 },
        "activeVersionRef": { "type": "string", "pattern": "^v[0-9]{8}$" },
        "versions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^v[0-9]{8}$" },
          "additionalProperties": { "$ref": "#/$defs/version" }
        },
        "deletionProtection": { "const": true },
        "signers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/envRef" }
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activationWindowStart", "rotationDeadline"],
      "properties": {
        "activationWindowStart": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T00:00:00Z$"
        },
        "rotationDeadline": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        }
      }
    }
  }
}
