{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.io/bootstrap/v1/recovery_policy.schema.json",
  "title": "Mindclade bootstrap recovery policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "bootstrap.mindclade.dev/v1" },
    "kind": { "const": "RecoveryPolicy" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryRegion",
        "recoveryRegion",
        "rootTrustBackendRef",
        "recoveryBackendRef",
        "signingRootRef",
        "restoreManifestPath",
        "objectives",
        "exports",
        "evidence",
        "drills",
        "isolation",
        "independentContacts"
      ],
      "properties": {
        "primaryRegion": { "const": "us-central1" },
        "recoveryRegion": { "const": "us-east4" },
        "rootTrustBackendRef": { "const": "root-trust" },
        "recoveryBackendRef": { "const": "recovery-plane" },
        "signingRootRef": { "const": "recovery-evidence" },
        "restoreManifestPath": { "const": "recovery/restore-manifest.yaml" },
        "objectives": {
          "type": "object",
          "additionalProperties": false,
          "required": ["recoveryPointHours", "recoveryTimeHours"],
          "properties": {
            "recoveryPointHours": { "type": "integer", "minimum": 1, "maximum": 24 },
            "recoveryTimeHours": { "type": "integer", "minimum": 1, "maximum": 8 }
          }
        },
        "exports": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimumRetainedStateGenerations",
            "encryptionKeyName",
            "includePublicTrustMetadata",
            "includePrivateKeyMaterial"
          ],
          "properties": {
            "minimumRetainedStateGenerations": { "type": "integer", "minimum": 3 },
            "encryptionKeyName": { "$ref": "#/$defs/envRef" },
            "includePublicTrustMetadata": { "const": true },
            "includePrivateKeyMaterial": { "const": false }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximumAgeHours", "signatureAlgorithm", "requireManifestDigest"],
          "properties": {
            "maximumAgeHours": { "type": "integer", "minimum": 1, "maximum": 2190 },
            "signatureAlgorithm": { "const": "EC_SIGN_P256_SHA256" },
            "requireManifestDigest": { "const": true }
          }
        },
        "drills": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cadence", "offlineByDefault", "connectedMode", "evidenceRetentionDays"],
          "properties": {
            "cadence": { "const": "quarterly" },
            "offlineByDefault": { "const": true },
            "connectedMode": { "const": "read-only" },
            "evidenceRetentionDays": { "type": "integer", "minimum": 2555 }
          }
        },
        "isolation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "denyPrimaryPlaneDependencies",
            "networkIsolationRequired",
            "recoveryAdministrator"
          ],
          "properties": {
            "required": { "const": true },
            "denyPrimaryPlaneDependencies": { "const": true },
            "networkIsolationRequired": { "const": true },
            "recoveryAdministrator": { "$ref": "#/$defs/envRef" }
          }
        },
        "independentContacts": {
          "type": "object",
          "minProperties": 2,
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]{1,62}$" },
          "additionalProperties": { "$ref": "#/$defs/envRef" }
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" } }
    },
    "envRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valueFrom"],
      "properties": {
        "valueFrom": {
          "type": "object",
          "additionalProperties": false,
          "required": ["env"],
          "properties": { "env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" } }
        }
      }
    }
  }
}
