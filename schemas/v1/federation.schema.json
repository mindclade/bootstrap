{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.io/bootstrap/v1/federation.schema.json",
  "title": "Mindclade bootstrap identity federation",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "bootstrap.mindclade.dev/v1"},
    "kind": {"const": "IdentityFederation"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workforce", "workloadIdentityProviders", "activation"],
      "properties": {
        "workforce": {"$ref": "#/$defs/workforce"},
        "workloadIdentityProviders": {
          "type": "object",
          "additionalProperties": false,
          "required": ["github", "github-config", "github-infrastructure", "github-ci-evidence", "buildkite", "gitops"],
          "properties": {
            "github": {
              "allOf": [
                {"$ref": "#/$defs/provider"},
                {
                  "properties": {
                    "platform": {"const": "github"},
                    "requiredClaims": {
                      "required": ["repository_owner_id", "repository_id", "ref", "workflow_ref"],
                      "minProperties": 4,
                      "maxProperties": 4
                    },
                    "serviceAccounts": {
                      "required": ["plan", "apply", "recovery"],
                      "minProperties": 3,
                      "maxProperties": 3
                    }
                  }
                }
              ]
            },
            "github-ci-evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "platform",
                "projectRef",
                "activationEnabled",
                "poolId",
                "issuerUri",
                "subjectClaim",
                "repositoryOwnerId",
                "repositoryIds",
                "writer",
                "verifier"
              ],
              "properties": {
                "platform": {"const": "github"},
                "projectRef": {"const": "identity-root"},
                "activationEnabled": {"type": "boolean"},
                "poolId": {"const": "github-ci-evidence"},
                "issuerUri": {"$ref": "#/$defs/envRef"},
                "subjectClaim": {"const": "assertion.sub"},
                "repositoryOwnerId": {"$ref": "#/$defs/expectedValue"},
                "repositoryIds": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "bootstrap",
                    "dot-github",
                    "github-config",
                    "gitops",
                    "infrastructure-live",
                    "mindclade"
                  ],
                  "properties": {
                    "bootstrap": {"$ref": "#/$defs/expectedValue"},
                    "dot-github": {"$ref": "#/$defs/expectedValue"},
                    "github-config": {"$ref": "#/$defs/expectedValue"},
                    "gitops": {"$ref": "#/$defs/expectedValue"},
                    "infrastructure-live": {"$ref": "#/$defs/expectedValue"},
                    "mindclade": {"$ref": "#/$defs/expectedValue"}
                  }
                },
                "writer": {"$ref": "#/$defs/ciEvidenceWriter"},
                "verifier": {"$ref": "#/$defs/ciEvidenceVerifier"}
              }
            },
            "github-config": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "platform",
                "projectRef",
                "activationEnabled",
                "poolId",
                "issuerUri",
                "subjectClaim",
                "repositoryOwnerId",
                "repositoryId",
                "immutableRepository",
                "repositoryFullName",
                "branchRef",
                "identities"
              ],
              "properties": {
                "platform": {"const": "github"},
                "projectRef": {"const": "identity-root"},
                "activationEnabled": {"type": "boolean"},
                "poolId": {"const": "github-config"},
                "issuerUri": {"$ref": "#/$defs/envRef"},
                "subjectClaim": {"const": "assertion.sub"},
                "repositoryOwnerId": {"$ref": "#/$defs/expectedValue"},
                "repositoryId": {"$ref": "#/$defs/expectedValue"},
                "immutableRepository": {"$ref": "#/$defs/expectedValue"},
                "repositoryFullName": {"$ref": "#/$defs/expectedValue"},
                "branchRef": {"$ref": "#/$defs/expectedValue"},
                "identities": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["plan", "apply"],
                  "properties": {
                    "plan": {"$ref": "#/$defs/githubConfigIdentity"},
                    "apply": {"$ref": "#/$defs/githubConfigIdentity"}
                  }
                }
              }
            },
            "github-infrastructure": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "platform",
                "projectRef",
                "poolId",
                "issuerUri",
                "subjectClaim",
                "repositoryOwnerId",
                "repositoryId",
                "immutableRepository",
                "repositoryFullName",
                "branchRef",
                "workflowRef",
                "drift",
                "identities"
              ],
              "properties": {
                "platform": {"const": "github"},
                "projectRef": {"const": "identity-root"},
                "poolId": {"const": "infrastructure-live"},
                "issuerUri": {"$ref": "#/$defs/envRef"},
                "subjectClaim": {"const": "assertion.sub"},
                "repositoryOwnerId": {"$ref": "#/$defs/expectedValue"},
                "repositoryId": {"$ref": "#/$defs/expectedValue"},
                "immutableRepository": {"$ref": "#/$defs/expectedValue"},
                "repositoryFullName": {"$ref": "#/$defs/expectedValue"},
                "branchRef": {"$ref": "#/$defs/expectedValue"},
                "workflowRef": {"$ref": "#/$defs/expectedValue"},
                "drift": {"$ref": "#/$defs/infrastructureDriftIdentity"},
                "identities": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "development-plan",
                    "development-apply",
                    "staging-plan",
                    "staging-apply",
                    "production-plan",
                    "production-apply",
                    "restricted-plan",
                    "restricted-apply"
                  ],
                  "properties": {
                    "development-plan": {"$ref": "#/$defs/infrastructureIdentity"},
                    "development-apply": {"$ref": "#/$defs/infrastructureIdentity"},
                    "staging-plan": {"$ref": "#/$defs/infrastructureIdentity"},
                    "staging-apply": {"$ref": "#/$defs/infrastructureIdentity"},
                    "production-plan": {"$ref": "#/$defs/infrastructureIdentity"},
                    "production-apply": {"$ref": "#/$defs/infrastructureIdentity"},
                    "restricted-plan": {"$ref": "#/$defs/infrastructureIdentity"},
                    "restricted-apply": {"$ref": "#/$defs/infrastructureIdentity"}
                  }
                }
              }
            },
            "buildkite": {
              "allOf": [
                {"$ref": "#/$defs/provider"},
                {
                  "properties": {
                    "platform": {"const": "buildkite"},
                    "requiredClaims": {
                      "required": ["organization_slug", "pipeline_slug", "pipeline_id", "build_branch", "step_key"],
                      "minProperties": 5,
                      "maxProperties": 5
                    },
                    "serviceAccounts": {
                      "required": ["bootstrap"],
                      "minProperties": 1,
                      "maxProperties": 1
                    }
                  }
                }
              ]
            },
            "gitops": {
              "allOf": [
                {"$ref": "#/$defs/provider"},
                {
                  "properties": {
                    "platform": {"const": "gitops"},
                    "requiredClaims": {
                      "required": ["repository", "ref", "subject"],
                      "minProperties": 3,
                      "maxProperties": 3
                    },
                    "serviceAccounts": {
                      "required": ["bootstrap"],
                      "minProperties": 1,
                      "maxProperties": 1
                    }
                  }
                }
              ]
            }
          }
        },
        "activation": {"$ref": "#/$defs/federationActivation"}
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"}}
    },
    "envRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valueFrom"],
      "properties": {
        "valueFrom": {
          "type": "object",
          "additionalProperties": false,
          "required": ["env"],
          "properties": {"env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}}
        }
      }
    },
    "expectedValue": {
      "oneOf": [
        {"$ref": "#/$defs/envRef"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["literal"],
          "properties": {"literal": {"type": "string", "minLength": 1, "pattern": "^[^*?]+$"}}
        }
      ]
    },
    "workforce": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRef", "location", "poolId", "providerId", "protocol", "issuerUri", "clientId", "clientSecret", "administratorGroup", "attributeMapping"],
      "properties": {
        "projectRef": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "location": {"const": "global"},
        "poolId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
        "providerId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
        "protocol": {"enum": ["oidc", "saml"]},
        "issuerUri": {"$ref": "#/$defs/envRef"},
        "clientId": {"$ref": "#/$defs/envRef"},
        "clientSecret": {"$ref": "#/$defs/envRef"},
        "administratorGroup": {"$ref": "#/$defs/envRef"},
        "attributeMapping": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject", "displayName", "groups"],
          "properties": {
            "subject": {"const": "assertion.sub"},
            "displayName": {"const": "assertion.name"},
            "groups": {"const": "assertion.groups"}
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRef", "accountId", "roles"],
      "properties": {
        "projectRef": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "accountId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"},
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(roles/[A-Za-z0-9_.]+|custom/[A-Za-z0-9_.]+)$",
            "not": {"enum": ["roles/owner", "roles/editor", "roles/viewer"]}
          }
        }
      }
    },
    "ciEvidenceWriter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "jobWorkflowRef", "allowedEvents", "branchRef", "releaseTagPrefix", "serviceAccount"],
      "properties": {
        "providerId": {"const": "writer"},
        "jobWorkflowRef": {"$ref": "#/$defs/envRef"},
        "allowedEvents": {
          "type": "array",
          "prefixItems": [{"const": "push"}, {"const": "release"}],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "branchRef": {"const": "refs/heads/main"},
        "releaseTagPrefix": {"const": "refs/tags/v"},
        "serviceAccount": {"$ref": "#/$defs/serviceAccount"}
      }
    },
    "infrastructureIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "environment", "allowedAudience", "serviceAccount"],
      "properties": {
        "providerId": {"type": "string", "pattern": "^(development|staging|production|restricted)-(plan|apply)$"},
        "environment": {"enum": ["trusted-build", "infrastructure-apply"]},
        "allowedAudience": {"$ref": "#/$defs/expectedValue"},
        "serviceAccount": {"$ref": "#/$defs/serviceAccount"}
      }
    },
    "githubConfigSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workflowRef", "contextType", "contextValue", "audience"],
      "properties": {
        "id": {"enum": ["github-config-drift-plan", "github-config-protected-plan", "github-config-protected-apply"]},
        "workflowRef": {"type": "string", "minLength": 1, "pattern": "^[^*?]+$"},
        "contextType": {"enum": ["ref", "environment"]},
        "contextValue": {"enum": ["refs/heads/main", "trusted-build", "infrastructure-apply"]},
        "audience": {"const": "sts.googleapis.com"}
      }
    },
    "githubConfigIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "serviceAccountId", "subjects"],
      "properties": {
        "providerId": {"enum": ["github-config-plan", "github-config-apply"]},
        "serviceAccountId": {"enum": ["github-config-plan", "github-config-apply"]},
        "subjects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/githubConfigSubject"}
        }
      }
    },
    "infrastructureDriftIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activationEnabled", "subjectId", "providerId", "serviceAccountId", "workflowRef", "environment", "allowedAudience"],
      "properties": {
        "activationEnabled": {"type": "boolean"},
        "subjectId": {"const": "infrastructure-drift-plan"},
        "providerId": {"const": "infrastructure-plan"},
        "serviceAccountId": {"const": "infrastructure-plan"},
        "workflowRef": {"const": "mindclade/infrastructure-live/.github/workflows/drift-detection.yml@refs/heads/main"},
        "environment": {"const": "trusted-build"},
        "allowedAudience": {"const": "sts.googleapis.com"}
      }
    },
    "ciEvidenceVerifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "repositoryId", "workflowRef", "workflowSha", "allowedEvents", "ref", "environment", "serviceAccount"],
      "properties": {
        "providerId": {"const": "verifier"},
        "repositoryId": {"$ref": "#/$defs/expectedValue"},
        "workflowRef": {"$ref": "#/$defs/expectedValue"},
        "workflowSha": {"$ref": "#/$defs/envRef"},
        "allowedEvents": {
          "type": "array",
          "prefixItems": [{"const": "workflow_dispatch"}],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "ref": {"$ref": "#/$defs/expectedValue"},
        "environment": {"const": "infrastructure-apply"},
        "serviceAccount": {"$ref": "#/$defs/serviceAccount"}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "projectRef", "poolId", "providerId", "issuerUri", "allowedAudience", "subjectClaim", "requiredClaims", "serviceAccounts"],
      "properties": {
        "platform": {"enum": ["github", "buildkite", "gitops"]},
        "projectRef": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "poolId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
        "providerId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
        "issuerUri": {"$ref": "#/$defs/envRef"},
        "allowedAudience": {"$ref": "#/$defs/expectedValue"},
        "subjectClaim": {"const": "assertion.sub"},
        "requiredClaims": {
          "type": "object",
          "minProperties": 2,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{1,62}$"},
          "additionalProperties": {"$ref": "#/$defs/expectedValue"}
        },
        "serviceAccounts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9-]{1,62}$"},
          "additionalProperties": {"$ref": "#/$defs/serviceAccount"}
        }
      }
    },
    "federationActivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "activeSubjectIds", "gatedSubjectIds", "blockers"],
      "properties": {
        "state": {"enum": ["BLOCKED", "FOUNDER_BOOTSTRAPPED", "CONNECTED_QUALIFIED"]},
        "exceptionRef": {"const": "FBE-0001"},
        "activeSubjectIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}
        },
        "gatedSubjectIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}
        }
      },
      "oneOf": [
        {
          "properties": {
            "state": {"const": "BLOCKED"},
            "activeSubjectIds": {"const": ["bootstrap-protected-plan", "bootstrap-protected-apply", "bootstrap-recovery-verification", "infrastructure-live-development-plan", "infrastructure-live-development-apply", "infrastructure-live-staging-plan", "infrastructure-live-staging-apply", "infrastructure-live-production-plan", "infrastructure-live-production-apply", "infrastructure-live-restricted-plan", "infrastructure-live-restricted-apply"]},
            "gatedSubjectIds": {"const": ["github-config-drift-plan", "github-config-protected-plan", "github-config-protected-apply", "infrastructure-drift-plan", "infrastructure-ci-evidence-verifier"]},
            "blockers": {"const": ["github-config-control-plane-federation-not-connected-qualified", "infrastructure-drift-federation-not-connected-qualified", "ci-evidence-federation-not-connected-qualified"]}
          },
          "not": {"required": ["exceptionRef"]}
        },
        {
          "required": ["exceptionRef"],
          "properties": {
            "state": {"const": "FOUNDER_BOOTSTRAPPED"},
            "exceptionRef": {"const": "FBE-0001"},
            "activeSubjectIds": {"const": ["bootstrap-protected-plan", "bootstrap-protected-apply", "bootstrap-recovery-verification", "infrastructure-live-development-plan", "infrastructure-live-development-apply", "infrastructure-live-staging-plan", "infrastructure-live-staging-apply", "infrastructure-live-production-plan", "infrastructure-live-production-apply", "infrastructure-live-restricted-plan", "infrastructure-live-restricted-apply", "github-config-protected-plan", "github-config-protected-apply"]},
            "gatedSubjectIds": {"const": ["github-config-drift-plan", "infrastructure-drift-plan", "infrastructure-ci-evidence-verifier"]},
            "blockers": {"const": ["independent-review-not-connected-qualified", "production-authority-disabled"]}
          }
        },
        {
          "properties": {
            "state": {"const": "CONNECTED_QUALIFIED"},
            "activeSubjectIds": {"const": ["bootstrap-protected-plan", "bootstrap-protected-apply", "bootstrap-recovery-verification", "infrastructure-live-development-plan", "infrastructure-live-development-apply", "infrastructure-live-staging-plan", "infrastructure-live-staging-apply", "infrastructure-live-production-plan", "infrastructure-live-production-apply", "infrastructure-live-restricted-plan", "infrastructure-live-restricted-apply", "github-config-drift-plan", "github-config-protected-plan", "github-config-protected-apply", "infrastructure-drift-plan", "infrastructure-ci-evidence-verifier"]},
            "gatedSubjectIds": {"const": []},
            "blockers": {"const": []}
          },
          "not": {"required": ["exceptionRef"]}
        }
      ]
    }
  }
}
