{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.io/bootstrap/v1/break_glass.schema.json",
  "title": "Mindclade bootstrap break-glass roles",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "bootstrap.mindclade.dev/v1"},
    "kind": {"const": "BreakGlassRoleSet"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRef", "location", "requesters", "approvers", "notificationRecipients", "entitlements"],
      "properties": {
        "projectRef": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "location": {"const": "global"},
        "requesters": {
          "type": "object",
          "minProperties": 2,
          "propertyNames": {"pattern": "^[a-z][a-z0-9-]{1,62}$"},
          "additionalProperties": {"$ref": "#/$defs/envRef"}
        },
        "approvers": {
          "type": "object",
          "minProperties": 2,
          "propertyNames": {"pattern": "^[a-z][a-z0-9-]{1,62}$"},
          "additionalProperties": {"$ref": "#/$defs/envRef"}
        },
        "notificationRecipients": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9-]{1,62}$"},
          "additionalProperties": {"$ref": "#/$defs/envRef"}
        },
        "entitlements": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9-]{1,62}$"},
          "additionalProperties": {"$ref": "#/$defs/entitlement"}
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"}}
    },
    "envRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valueFrom"],
      "properties": {
        "valueFrom": {
          "type": "object",
          "additionalProperties": false,
          "required": ["env"],
          "properties": {"env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}}
        }
      }
    },
    "entitlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetProjectRef", "roles", "maxDurationSeconds", "approval", "standingAccess"],
      "properties": {
        "targetProjectRef": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^roles/[A-Za-z0-9_.]+$",
            "not": {"enum": ["roles/owner", "roles/editor", "roles/viewer"]}
          }
        },
        "maxDurationSeconds": {"type": "integer", "minimum": 1, "maximum": 7200},
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredApprovals", "justificationRequired", "allowSelfApproval"],
          "properties": {
            "requiredApprovals": {"type": "integer", "minimum": 2},
            "justificationRequired": {"const": true},
            "allowSelfApproval": {"const": false}
          }
        },
        "standingAccess": {"const": false}
      }
    }
  }
}
