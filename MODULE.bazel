module(
    name = "mindclade_bootstrap",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "rules_python", version = "1.7.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//tooling:go.mod")
use_repo(
    go_deps,
    "com_github_santhosh_tekuri_jsonschema_v5",
    "in_gopkg_yaml_v3",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.7")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.single_version_override(
    python_version = "3.14.7",
    sha256 = {
        "aarch64-apple-darwin": "abbf6e8530a283ed795fa91fd6bcf4501e2b1fa287b2cb1c15b70d3028f3a7c9",
        "aarch64-unknown-linux-gnu": "f278d66c15e81f6c77719892e3eb32ff4bca5fc4ab424e171d14bc12bb88b4ee",
        "x86_64-unknown-linux-gnu": "a3a4e4b81b138960c7c546694df8a77578c0b6aa46d47e96f49b9e10e8f860c9",
    },
    urls = [
        "https://github.com/astral-sh/python-build-standalone/releases/download/20260805/cpython-{python_version}+20260805-{platform}-install_only_stripped.tar.gz",
    ],
)
python.override(
    minor_mapping = {"3.14": "3.14.7"},
)
python.toolchain(
    is_default = True,
    python_version = "3.14",
)
